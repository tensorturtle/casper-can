          }
        }
      }
    },
    "Reads 0 for the first half-second after connecting, until the window has filled." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 후 처음 0.5초 동안은 측정 구간이 채워질 때까지 0으로 표시돼요."
          }
