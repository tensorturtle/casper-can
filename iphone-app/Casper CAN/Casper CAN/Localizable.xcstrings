        }
      }
    },
    "All of them must be answering, or the tile shows “no data” rather than a number computed from a partial set." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 신호가 응답해야 해요. 일부만 응답하면 그 일부로 계산한 숫자 대신 “데이터 없음”을 표시해요."
          }
        }
      }
    },
    "Allow Bluetooth for this app in Settings, then come back." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 이 앱의 블루투스 사용을 허용한 다음 돌아오세요."
          }
        }
