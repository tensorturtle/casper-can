    "Engine Speed" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진 회전수"
          }
        }
      }
    },
    "Engine assumed %lld cylinders, %@ L total (1.0 T-GDI). Cylinder count does not enter the arithmetic — a four-stroke pumps its total displacement once per two crank revolutions however it is divided up." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진은 %1$lld기통, 총 배기량 %2$@ L(1.0 T-GDI)로 가정해요. 기통 수는 계산에 들어가지 않아요. 4행정 엔진은 배기량을 어떻게 나누든 크랭크축 두 바퀴마다 전체 배기량만큼 공기를 들이마시기 때문이에요."
          }
        }
      }
    },
    "Equiv. Ratio" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당량비"
          }
        }
      }
    },
