            "value" : "모듈 전압"
          }
        }
      }
    },
    "Monochrome" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흑백"
          }
        }
      }
    },
    "Motion & Driver Input" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주행 및 운전자 입력"
          }
        }
      }
    },
    "NOT a measurement. This vehicle publishes no air-flow or fuel-flow signal at all, so there is nothing to check this against." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "측정값이 아니에요. 이 차량은 공기 유량이나 연료 유량 신호를 전혀 보내지 않아서, 이 값을 검증할 기준이 없어요."
          }
        }
      }
    },
    "Neutral" : {
      "localizations" : {
